# ── 접속 ─────────────────────────────────────────────
# 웹 화면 로그인 토큰 (16자 이상). 예: openssl rand -hex 24
WEB_ACCESS_TOKEN=
# 기본은 이 PC에서만 접속 (127.0.0.1). 휴대폰 등 다른 기기에서 쓰려면 0.0.0.0 (신뢰하는 네트워크에서만)
WEB_HOST=127.0.0.1
WEB_PORT=3939

# ── 작업 경로 제한 ────────────────────────────────────
# 모든 프로젝트는 이 폴더 안에 있어야 합니다 (절대 경로)
WORKSPACE_ROOT=/Users/me/work
# 프로젝트 목록 파일 (기본 projects.json)
PROJECTS_FILE=projects.json

# ── 권한 ─────────────────────────────────────────────
# default     : 파일 수정·명령 실행마다 승인 버튼
# acceptEdits : 프로젝트 안 파일 수정은 자동 승인, 명령은 승인 버튼
# plan        : 계획만 세우고, 실행 전 승인
# bypassPermissions : 도구를 확인 없이 자동 실행
PERMISSION_MODE=default
# 승인 버튼 응답 대기 시간(초). 넘으면 거절로 처리하고 작업 종료
APPROVAL_TIMEOUT_SEC=600

# ── 선택 ─────────────────────────────────────────────
# CLAUDE_MODEL=sonnet
# CLAUDE_MAX_TURNS=50
# 불러올 Claude Code 설정: project(CLAUDE.md·.claude/settings.json) | user | local | none
# user 를 넣으면 ~/.claude/settings.json 의 allow 규칙도 적용됩니다
CLAUDE_SETTING_SOURCES=project
# CLAUDE_EXECUTABLE=/절대/경로/claude
MAX_IMAGES=4
MAX_IMAGE_MB=5
MAX_PENDING_PER_CONVERSATION=3
DB_PATH=data/app.sqlite
LOG_LEVEL=info
